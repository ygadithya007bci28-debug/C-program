#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* simplifyPath(char* path) {
    int len = strlen(path);
    
    // Allocate space for the stack array to hold string pointers
    char** stack = (char**)malloc(len * sizeof(char*));
    int top = 0;
    
    // Use strtok to split the path by '/'
    char* token = strtok(path, "/");
    while (token != NULL) {
        if (strcmp(token, ".") == 0 || strcmp(token, "") == 0) {
            // Do nothing for current directory or empty tokens
        } else if (strcmp(token, "..") == 0) {
            // Go up one level if stack is not empty
            if (top > 0) {
                top--;
            }
        } else {
            // Push valid directory name onto the stack
            stack[top++] = token;
        }
        token = strtok(NULL, "/");
    }
    
    // Allocate memory for the final canonical path string
    char* result = (char*)malloc((len + 2) * sizeof(char));
    result[0] = '\0';
    
    // Reconstruct the path from the stack
    if (top == 0) {
        strcpy(result, "/");
    } else {
        for (int i = 0; i < top; i++) {
            strcat(result, "/");
            strcat(result, stack[i]);
        }
    }
    
    free(stack);
    return result;
}
