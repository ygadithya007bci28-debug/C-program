#include <stdio.h>
#include <string.h>

int main() {
    char s[1001];
    
    // Read the line until a newline character is encountered
    if (scanf("%1000[^\n]", s) == 1) {
        int length = strlen(s);
        
        for (int i = 0; i < length; i++) {
            if (s[i] == ' ') {
                printf("\n");
            } else {
                printf("%c", s[i]);
            }
        }
        printf("\n"); // Print final newline
    }
    
    return 0;
}
