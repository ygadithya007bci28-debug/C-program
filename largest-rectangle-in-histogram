#include <stdio.h>
#include <stdlib.h>

int largestRectangleArea(int* heights, int heightsSize) {
    if (heightsSize == 0) return 0;
    
    // Allocate space for the stack array to hold indices
    int* stack = (int*)malloc((heightsSize + 1) * sizeof(int));
    int top = -1;
    int max_area = 0;
    
    for (int i = 0; i <= heightsSize; i++) {
        // Use an imaginary 0-height bar at the end to clear the stack
        int current_height = (i == heightsSize) ? 0 : heights[i];
        
        while (top != -1 && heights[stack[top]] > current_height) {
            int h = heights[stack[top--]]; // Height of the popped bar
            
            // If stack is empty, width extends from index 0 to i
            int w = (top == -1) ? i : (i - stack[top] - 1); 
            
            int current_area = h * w;
            if (current_area > max_area) {
                max_area = current_area;
            }
        }
        stack[++top] = i; // Push current index onto stack
    }
    
    free(stack);
    return max_area;
}
