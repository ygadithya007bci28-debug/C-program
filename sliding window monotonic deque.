#include <stdio.h>
#include <stdlib.h>

int maxResult(int* nums, int numsSize, int k) {
    // dp[i] stores the maximum score to reach index i
    int* dp = (int*)malloc(numsSize * sizeof(int));
    
    // Deque stores the indices of dp array in a decreasing order of values
    int* deque = (int*)malloc(numsSize * sizeof(int));
    int head = 0, tail = 0;
    
    // Base case
    dp[0] = nums[0];
    deque[tail++] = 0; // Push index 0 into the deque
    
    for (int i = 1; i < numsSize; i++) {
        // 1. Remove elements out of the current window [i - k, i - 1]
        while (head < tail && deque[head] < i - k) {
            head++;
        }
        
        // 2. The front of the deque has the index of the max value in the window
        dp[i] = nums[i] + dp[deque[head]];
        
        // 3. Maintain monotonic decreasing order in the deque
        while (head < tail && dp[deque[tail - 1]] <= dp[i]) {
            tail--;
        }
        
        // 4. Push the current index into the deque
        deque[tail++] = i;
    }
    
    int result = dp[numsSize - 1];
    
    // Free allocated memory
    free(dp);
    free(deque);
    
    return result;
}
