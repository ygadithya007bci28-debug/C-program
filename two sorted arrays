#include <limits.h>

#define MIN(a, b) ((a) < (b) ? (a) : (b))
#define MAX(a, b) ((a) > (b) ? (a) : (b))

double findMedianSortedArrays(int* nums1, int nums1Size, int* nums2, int nums2Size) {
    // Ensure nums1 is the smaller array to minimize the binary search range O(log(min(m, n)))
    if (nums1Size > nums2Size) {
        return findMedianSortedArrays(nums2, nums2Size, nums1, nums1Size);
    }

    int m = nums1Size;
    int n = nums2Size;
    int low = 0;
    int high = m;
    int totalLeft = (m + n + 1) / 2;

    while (low <= high) {
        // Partition nums1 and calculate the corresponding partition in nums2
        int i = low + (high - low) / 2;
        int j = totalLeft - i;

        // Boundary elements around the partitions
        int left1 = (i == 0) ? INT_MIN : nums1[i - 1];
        int right1 = (i == m) ? INT_MAX : nums1[i];

        int left2 = (j == 0) ? INT_MIN : nums2[j - 1];
        int right2 = (j == n) ? INT_MAX : nums2[j];

        // Check if we found the correct partition
        if (left1 <= right2 && left2 <= right1) {
            // If total elements are odd, return the max of the left side
            if ((m + n) % 2 == 1) {
                return MAX(left1, left2);
            }
            // If total elements are even, return the average of the middle elements
            return (MAX(left1, left2) + MIN(right1, right2)) / 2.0;
        } 
        // If left1 is too big, move the partition left in nums1
        else if (left1 > right2) {
            high = i - 1;
        } 
        // If left2 is too big, move the partition right in nums1
        else {
            low = i + 1;
        }
    }

    return 0.0;
}
