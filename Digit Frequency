#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char num[1001];
    int frequency[10] = {0};

    // Read the input string
    scanf("%1000s", num);

    // Count the frequency of each digit
    for (int i = 0; num[i] != '\0'; i++) {
        if (isdigit(num[i])) {
            frequency[num[i] - '0']++;
        }
    }

    // Print the frequencies separated by spaces
    for (int i = 0; i < 10; i++) {
        printf("%d", frequency[i]);
        if (i < 9) {
            printf(" ");
        }
    }
    printf("\n");

    return 0;
}
