#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>
#include <string.h>

int calculate(char* s) {
    int len = strlen(s);
    if (len == 0) return 0;

    // In the worst case, the stack won't hold more elements than the string length
    int* stack = (int*)malloc(len * sizeof(int));
    int top = -1;

    long long currentNumber = 0;
    char sign = '+';

    for (int i = 0; i < len; i++) {
        char currentChar = s[i];

        // Build the current integer number digit-by-digit
        if (isdigit((unsigned char)currentChar)) {
            currentNumber = currentNumber * 10 + (currentChar - '0');
        }

        // If the character is an operator or we reached the end of the string
        if ((!isdigit((unsigned char)currentChar) && currentChar != ' ') || i == len - 1) {
            if (sign == '+') {
                stack[++top] = currentNumber;
            } else if (sign == '-') {
                stack[++top] = -currentNumber;
            } else if (sign == '*') {
                // Evaluate multiplication immediately
                stack[top] = stack[top] * currentNumber;
            } else if (sign == '/') {
                // Evaluate division immediately (C natively truncates toward zero)
                stack[top] = stack[top] / currentNumber;
            }
            
            // Update the operator sign for the next segment and reset the number tracker
            sign = currentChar;
            currentNumber = 0;
        }
    }

    // Sum up all calculated elements remaining inside the stack
    int result = 0;
    while (top >= 0) {
        result += stack[top--];
    }

    free(stack);
    return result;
}
