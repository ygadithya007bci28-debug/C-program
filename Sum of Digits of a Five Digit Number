#include <stdio.h>

int main() {
    int n;
    int sum = 0;
    
    // Read the five-digit integer
    scanf("%d", &n);
    
    // Loop to extract and sum each digit
    while (n > 0) {
        sum += n % 10; // Extract the last digit and add to sum
        n /= 10;       // Remove the last digit from the number
    }
    
    // Print the final sum
    printf("%d\n", sum);
    
    return 0;
}
